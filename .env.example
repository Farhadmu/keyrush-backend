# KEYRUSH Backend Environment Variables Example

# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/keyrush

# Redis Configuration (Required in production for locks & presence)
REDIS_HOST=localhost
REDIS_PORT=6379
# Or use:
# REDIS_URL=redis://localhost:6379

# Authentication (JWT) - Must be >= 32 characters in production
JWT_SECRET=dev_jwt_secret_min_32_characters_long_12345
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_min_32_characters_12345
JWT_REFRESH_EXPIRATION=7d

# Cryptography & Security Secrets
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CERTIFICATE_SIGNING_SECRET=dev_cert_signing_secret_min_32_chars_12345

# AI Telemetry Analysis (Optional)
# OPENAI_API_KEY=sk-...

# Game Tuning Defaults
MIN_MULTIPLAYER_PLAYERS=2
MAX_MULTIPLAYER_PLAYERS=7
MIN_EVENT_PARTICIPANTS=20
MAX_EVENT_PARTICIPANTS=300
