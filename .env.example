# KEYRUSH Backend Environment Variables Example

# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
RATE_LIMIT_MAX=180

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/keyrush
# In-memory fallback is automatically triggered in development if MONGODB_URI is unreachable

# Redis Configuration (Optional in local dev; falls back to in-memory adapter)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or full Redis connection string:
# REDIS_URL=redis://localhost:6379

# Authentication (JWT)
JWT_SECRET=your_jwt_secret_key_min_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_min_32_chars
JWT_REFRESH_EXPIRATION=7d

# Game Tuning Defaults
MIN_MULTIPLAYER_PLAYERS=2
MAX_MULTIPLAYER_PLAYERS=7
MIN_EVENT_PARTICIPANTS=20
MAX_EVENT_PARTICIPANTS=300
